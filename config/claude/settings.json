{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "EDITOR": "code"
  },
  "permissions": {
    "allow": [],
    "defaultMode": "auto"
  },
  "model": "opusplan",
  "skillOverrides": {
    "image-list": "off"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Library/Application\\ Support/AIProgressMonitor/hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Library/Application\\ Support/AIProgressMonitor/hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Library/Application\\ Support/AIProgressMonitor/hook.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/Library/Application\\ Support/AIProgressMonitor/hook.sh"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/Library/Application\\ Support/AIProgressMonitor/hook.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Library/Application\\ Support/AIProgressMonitor/hook.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Library/Application\\ Support/AIProgressMonitor/hook.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Library/Application\\ Support/AIProgressMonitor/hook.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "ml-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/monstar-lab-group/ml-claude-plugins.git"
      }
    }
  },
  "language": "japanese",
  "effortLevel": "medium",
  "advisorModel": "opus",
  "theme": "light",
  "autoCompactEnabled": true
}
